# ---------------------------------------------------------------
# Frontend (Vite) — safe to expose to the browser
# ---------------------------------------------------------------
# Leave both empty to run in local DEMO mode (in-browser Postgres via PGlite,
# mock email delivery). Fill both to use a real Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: force a mode ("supabase" | "demo"). Defaults to supabase when URL+key are set.
VITE_BACKEND_MODE=
# Public base URL used in emails for secure offer links (defaults to window.location.origin)
VITE_PUBLIC_APP_URL=

# ---------------------------------------------------------------
# Supabase Edge Function secrets — NEVER put these in VITE_* vars.
# Set with:  supabase secrets set KEY=value
# ---------------------------------------------------------------
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
# Email delivery mode: "mock" (log only, default) or "resend"
EMAIL_MODE=mock
RESEND_API_KEY=
EMAIL_FROM=HRMS <no-reply@your-verified-domain.com>
# When set, every outgoing email is redirected to this address (use for testing / UAT)
EMAIL_TEST_RECIPIENT=
